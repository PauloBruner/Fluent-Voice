# Copie este arquivo para .env e preencha com suas chaves.
# NUNCA commite o arquivo .env.

# Chave da API do Google Cloud Text-to-Speech
GOOGLE_TTS_KEY=

# Chave da API da Anthropic (Claude) - usada na tradução
ANTHROPIC_API_KEY=

# Limite de requisições por IP a cada 24h (contado separadamente para TTS e tradução)
FREE_LIMIT=20
