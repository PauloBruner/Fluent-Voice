{
  "manifest_version": 3,
  "name": "FluentVoice",
  "description": "Translate and practice pronunciation between English, Portuguese (Brazil), and Spanish.",
  "version": "2.0.0",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FluentVoice"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
